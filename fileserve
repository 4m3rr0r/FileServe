# Server Information
# ============================================================

show_server_info() {

    local mode="$1"
    local port="$2"

    echo
    echo -e "${C}────────────────────────────────────────────────${NC}"

    echo -e "${G}[+] Mode       :${NC} $mode"
    echo -e "${G}[+] Interface  :${NC} $INTERFACE"
    echo -e "${G}[+] IP         :${NC} $MY_IP"
    echo -e "${G}[+] Port       :${NC} $port"
    echo -e "${G}[+] Directory  :${NC} $WORKDIR"

    if [[ -n "$AUTH_USER" ]]; then

        echo -e "${G}[+] Auth       :${NC} enabled"
        echo -e "${G}[+] Username   :${NC} $AUTH_USER"

    else

        echo -e "${G}[+] Auth       :${NC} disabled"

    fi

    echo -e "${C}────────────────────────────────────────────────${NC}"

    echo

    # Show ALL interfaces except lo
    show_all_interfaces
}

