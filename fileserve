# ============================================================
# Show Commands
# ============================================================

show_commands() {

    local mode="$1"
    local port="$2"

    case "$mode" in

        "HTTP Download")

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_LINUX" == true ]]; then

                show_download_linux "$port"

            fi

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_WINDOWS" == true ]]; then

                show_download_windows "$port"

            fi

            ;;

        "HTTP Upload")

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_LINUX" == true ]]; then

                show_upload_linux "$port"

            fi

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_WINDOWS" == true ]]; then

                show_upload_windows "$port"

            fi

            ;;

        "FTP")

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_LINUX" == true ]]; then

                show_ftp_linux "$port"

            fi

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_WINDOWS" == true ]]; then

                show_ftp_windows "$port"

            fi

            ;;

        "SMB")

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_LINUX" == true ]]; then

                show_smb_linux "$port"

            fi

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_WINDOWS" == true ]]; then

                show_smb_windows "$port"

            fi

            ;;

        "WebDAV")

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_LINUX" == true ]]; then

                show_webdav_linux "$port"

            fi

            if [[ "$SHOW_COMMANDS" == true ||
                  "$SHOW_WINDOWS" == true ]]; then

                show_webdav_windows "$port"

            fi

            ;;

    esac
}

# ============================================================
# Validate Command Options
# ============================================================

validate_command_options() {

    local count=0

    if [[ "$SHOW_COMMANDS" == true ]]; then
        count=$((count + 1))
    fi

    if [[ "$SHOW_LINUX" == true ]]; then
        count=$((count + 1))
    fi

    if [[ "$SHOW_WINDOWS" == true ]]; then
        count=$((count + 1))
    fi

    if (( count > 1 )); then

        log_error "Use only one of: -sh, -sl, -sw"

        exit 1

    fi
}

# ============================================================
# HTTP Download Server
# ============================================================

run_download() {

    PORT="${PORT:-$HTTP_PORT}"

    validate_port
    check_port_available "$PORT"

    show_server_info "HTTP Download" "$PORT"

    if [[ "$SHOW_COMMANDS" == true ||
          "$SHOW_LINUX" == true ||
          "$SHOW_WINDOWS" == true ]]; then

        show_commands "HTTP Download" "$PORT"

    fi

    log_success "Starting HTTP download server..."

    cd "$WORKDIR" || exit 1

    python3 -m http.server "$PORT"
}

# ============================================================
# HTTP Upload Server
# ============================================================

run_upload() {

    PORT="${PORT:-$UPLOAD_PORT}"

    validate_port
    check_port_available "$PORT"

    check_uploadserver

    show_server_info "HTTP Upload" "$PORT"

    if [[ "$SHOW_COMMANDS" == true ||
          "$SHOW_LINUX" == true ||
          "$SHOW_WINDOWS" == true ]]; then

        show_commands "HTTP Upload" "$PORT"

    fi

    log_success "Starting HTTP upload server..."

    cd "$WORKDIR" || exit 1

    if [[ -n "$AUTH_USER" ]]; then

        python3 -m uploadserver "$PORT" \
            --basic-auth "${AUTH_USER}:${AUTH_PASS}"

    else

        python3 -m uploadserver "$PORT"

    fi
}

# ============================================================
# FTP Server
# ============================================================

run_ftp() {

    PORT="${PORT:-$FTP_PORT}"

    validate_port
    check_port_available "$PORT"

    check_pyftpdlib

    show_server_info "FTP" "$PORT"

    if [[ "$SHOW_COMMANDS" == true ||
          "$SHOW_LINUX" == true ||
          "$SHOW_WINDOWS" == true ]]; then

        show_commands "FTP" "$PORT"

    fi

    log_success "Starting FTP server..."

    cd "$WORKDIR" || exit 1

    if [[ -n "$AUTH_USER" ]]; then

        python3 -m pyftpdlib \
            --port "$PORT" \
            --write \
            --user="$AUTH_USER" \
            --password="$AUTH_PASS"

    else

        python3 -W ignore -m pyftpdlib \
            --port "$PORT" \
            --write

    fi
}

# ============================================================
# Download SMB Server
# ============================================================

download_smbserver() {

    mkdir -p "$SMB_BIN_DIR"

    if [[ -f "$SMB_SCRIPT" ]]; then
        return 0
    fi

    log_info "Downloading Impacket smbserver.py..."

    if ! command_exists curl; then

        log_error "curl is required to download smbserver.py."

        exit 1

    fi

    curl -fsSL \
        "https://raw.githubusercontent.com/fortra/impacket/impacket_0_11_0/examples/smbserver.py" \
        -o "$SMB_SCRIPT"

    chmod +x "$SMB_SCRIPT"

    log_success "smbserver.py installed at: $SMB_SCRIPT"
}

# ============================================================
# SMB Server
# ============================================================

run_smb() {

    PORT="${PORT:-$SMB_PORT}"

    validate_port

    if [[ "$PORT" != "445" ]]; then

        log_warning "SMB server uses TCP port 445."
        log_warning "Custom SMB port is not applied."

        PORT=445

    fi

    check_port_available "$PORT"

    download_smbserver

    show_server_info "SMB" "$PORT"

    if [[ "$SHOW_COMMANDS" == true ||
          "$SHOW_LINUX" == true ||
          "$SHOW_WINDOWS" == true ]]; then

        show_commands "SMB" "$PORT"

    fi

    log_success "Starting SMB server..."

    cd "$WORKDIR" || exit 1

    if [[ -n "$AUTH_USER" ]]; then

        log_warning "SMB authentication handling depends on the Impacket server configuration."

        sudo python3 "$SMB_SCRIPT" \
            -smb2support \
            -username "$AUTH_USER" \
            -password "$AUTH_PASS" \
            share "$WORKDIR"

    else

        sudo python3 "$SMB_SCRIPT" \
            -smb2support \
            share "$WORKDIR"

    fi
}

# ============================================================
# WebDAV Cleanup
# ============================================================

cleanup_webdav() {

    trap - INT TERM EXIT

    if [[ -n "$TAIL_PID" ]]; then
        kill "$TAIL_PID" 2>/dev/null
    fi

    if [[ -n "$SERVER_PID" ]]; then
        sudo kill "$SERVER_PID" 2>/dev/null
    fi

    if [[ -n "$TMPDIR" && -d "$TMPDIR" ]]; then
        rm -rf "$TMPDIR"
    fi

    exit 0
}

# ============================================================
# Generate WebDAV Certificate
# ============================================================

generate_webdav_certificate() {

    mkdir -p "$TMPDIR"

    openssl req \
        -x509 \
        -nodes \
        -days 365 \
        -newkey rsa:2048 \
        -keyout "$TMPDIR/server.key" \
        -out "$TMPDIR/server.crt" \
        -subj "/CN=${MY_IP}" \
        >/dev/null 2>&1
}

# ============================================================
# WebDAV Server
# ============================================================

run_webdav() {

    PORT="${PORT:-$WEBDAV_PORT}"

    validate_port
    check_nginx
    check_port_available "$PORT"

    mkdir -p "$WORKDIR/upload"

    TMPDIR="$(mktemp -d)"

    local nginx_conf="$TMPDIR/nginx.conf"

    if [[ "$USE_SSL" == true ]]; then

        generate_webdav_certificate

        cat > "$nginx_conf" <<EOF
worker_processes 1;

events {
    worker_connections 1024;
}

http {

    server {

        listen ${PORT} ssl;
        server_name _;

        ssl_certificate ${TMPDIR}/server.crt;
        ssl_certificate_key ${TMPDIR}/server.key;

        root ${WORKDIR};

        client_max_body_size 0;

        dav_methods PUT DELETE MKCOL COPY MOVE;
        create_full_put_path on;

        autoindex on;

    }
}
EOF

    else

        cat > "$nginx_conf" <<EOF
worker_processes 1;

events {
    worker_connections 1024;
}

http {

    server {

        listen ${PORT};
        server_name _;

        root ${WORKDIR};

        client_max_body_size 0;

        dav_methods PUT DELETE MKCOL COPY MOVE;
        create_full_put_path on;

        autoindex on;

    }
}
EOF

    fi

    trap cleanup_webdav INT TERM EXIT

    show_server_info "WebDAV" "$PORT"

    if [[ "$SHOW_COMMANDS" == true ||
          "$SHOW_LINUX" == true ||
          "$SHOW_WINDOWS" == true ]]; then

        show_commands "WebDAV" "$PORT"

    fi

    log_success "Starting WebDAV server..."

    sudo nginx \
        -c "$nginx_conf" \
        -p "$TMPDIR/" \
        -g "pid ${TMPDIR}/nginx.pid; daemon off;" &

    SERVER_PID=$!

    wait "$SERVER_PID"
}

# ============================================================
# Server Mode Selection
# ============================================================

set_mode() {

    local requested="$1"

    if [[ -n "$MODE" ]]; then
        log_error "Only one server mode can be selected."
        exit 1
    fi

    MODE="$requested"
}

# ============================================================
# Argument Parsing
# ============================================================

parse_arguments() {

    while [[ $# -gt 0 ]]; do

        case "$1" in

            # ------------------------------------------------
            # Modes
            # ------------------------------------------------

            -w|--webdav)
                set_mode "webdav"
                ;;

            -n|--nginx)
                set_mode "webdav"
                ;;

            -s|--smb)
                set_mode "smb"
                ;;

            -d|--download)
                set_mode "download"
                ;;

            -u|--upload)
                set_mode "upload"
                ;;

            -f|--ftp)
                set_mode "ftp"
                ;;

            # ------------------------------------------------
            # Directory
            # ------------------------------------------------

            -D|--directory)

                if [[ -z "${2:-}" ]]; then

                    log_error "Missing directory argument."

                    exit 1

                fi

                WORKDIR="$2"

                shift

                ;;

            # ------------------------------------------------
            # Interface
            #
            # Both -i and -I are supported.
            # ------------------------------------------------

            -i|-I|--interface)

                if [[ -z "${2:-}" ]]; then

                    log_error "Missing interface argument."

                    exit 1

                fi

                INTERFACE="$2"

                shift

                ;;

            # ------------------------------------------------
            # Port
            # ------------------------------------------------

            -p|--port)

                if [[ -z "${2:-}" ]]; then

                    log_error "Missing port argument."

                    exit 1

                fi

                PORT="$2"

                shift

                ;;

            # ------------------------------------------------
            # Authentication
            # ------------------------------------------------

            -U|--user)

                if [[ -z "${2:-}" ]]; then

                    log_error "Missing username argument."

                    exit 1

                fi

                AUTH_USER="$2"

                shift

                ;;

            -P|--pass)

                if [[ -z "${2:-}" ]]; then

                    log_error "Missing password argument."

                    exit 1

                fi

                AUTH_PASS="$2"

                shift

                ;;

            # ------------------------------------------------
            # Other options
            # ------------------------------------------------

            --ssl)

                USE_SSL=true

                ;;

            --verbose)

                VERBOSE=true

                ;;

            --quiet)

                QUIET=true

                ;;

            # ------------------------------------------------
            # Command display
            # ------------------------------------------------

            -sh|--show)

                SHOW_COMMANDS=true

                ;;

            -sl|--linux)

                SHOW_LINUX=true

                ;;

            -sw|--windows)

                SHOW_WINDOWS=true

                ;;

            # ------------------------------------------------
            # Version / Help
            # ------------------------------------------------

            -V|--version)

                show_version

                exit 0

                ;;

            -h|--help)

                show_help

                exit 0

                ;;

            # ------------------------------------------------
            # Unknown
            # ------------------------------------------------

            *)

                log_error "Unknown option: $1"

                echo

                show_help

                exit 1

                ;;

        esac

        shift

    done
}

# ============================================================
# Main
# ============================================================

main() {

    parse_arguments "$@"

    validate_command_options

    if [[ -z "$MODE" ]]; then

        show_banner
        show_help

        exit 1

    fi

    validate_directory

    # --------------------------------------------------------
    # Detect every interface and select the best IP
    # --------------------------------------------------------

    detect_ip

    # --------------------------------------------------------
    # SSL only works with WebDAV
    # --------------------------------------------------------

    if [[ "$USE_SSL" == true &&
          "$MODE" != "webdav" ]]; then

        log_error "--ssl can only be used with WebDAV."

        exit 1

    fi

    # --------------------------------------------------------
    # No usable interface
    # --------------------------------------------------------

    if [[ -z "$MY_IP" ]]; then

        log_error "No usable non-loopback IPv4 interface detected."

        echo

        echo "Run:"

        echo "  ip -br -4 addr"

        echo

        exit 1

    fi

    # --------------------------------------------------------
    # Banner
    # --------------------------------------------------------

    if [[ "$QUIET" != true ]]; then
        show_banner
    fi

    # --------------------------------------------------------
    # Start selected server
    # --------------------------------------------------------

    case "$MODE" in

        download)
            run_download
            ;;

        upload)
            run_upload
            ;;

        ftp)
            run_ftp
            ;;

        smb)
            run_smb
            ;;

        webdav)
            run_webdav
            ;;

        *)
            log_error "Invalid mode: $MODE"
            exit 1
            ;;

    esac
}

# ============================================================
# Start
# ============================================================

main "$@"
