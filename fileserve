# ============================================================
# Command Check
# ============================================================

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# ============================================================
# Python Package Installer
# ============================================================

install_python_package() {

    local package="$1"

    if python3 -m pip show "$package" >/dev/null 2>&1; then
        return 0
    fi

    log_info "Installing Python package: $package"

    if python3 -m pip install --user "$package"; then
        log_success "$package installed."
    else
        log_error "Failed to install Python package: $package"
        exit 1
    fi
}

# ============================================================
# Uploadserver Check
# ============================================================

check_uploadserver() {

    if python3 -m uploadserver --help >/dev/null 2>&1; then
        return 0
    fi

    log_warning "Python uploadserver module is not installed."

    install_python_package "uploadserver"
}

# ============================================================
# FTP Check
# ============================================================

check_pyftpdlib() {

    if python3 -m pyftpdlib --help >/dev/null 2>&1; then
        return 0
    fi

    log_warning "pyftpdlib is not installed."

    install_python_package "pyftpdlib"
}

# ============================================================
# Nginx Check
# ============================================================

check_nginx() {

    if command_exists nginx; then
        return 0
    fi

    log_warning "nginx is not installed."

    if command_exists apt-get; then

        log_info "Installing nginx..."

        sudo apt-get update
        sudo apt-get install -y nginx

    else

        log_error "Cannot automatically install nginx."
        exit 1

    fi
}

# ============================================================
# Detect ALL Non-Loopback IPv4 Interfaces
# ============================================================

detect_all_interfaces() {

    INTERFACE_LIST=()

    while IFS='|' read -r iface ip_addr; do

        [[ -z "$iface" ]] && continue
        [[ -z "$ip_addr" ]] && continue

        # Never include loopback
        [[ "$iface" == "lo" ]] && continue
        [[ "$ip_addr" == 127.* ]] && continue

        INTERFACE_LIST+=("${iface}|${ip_addr}")

    done < <(
        ip -o -4 addr show up 2>/dev/null |
        awk '
            $2 != "lo" && $4 !~ /^127\./ {
                split($4, a, "/")
                print $2 "|" a[1]
            }
        '
    )
}

# ============================================================
# Select IP For Server Commands
# ============================================================
#
# Important:
#
# FileServe ALWAYS discovers and displays all interfaces.
#
# If the user specifies:
#
#   -i tun0
#
# then tun0 is selected.
#
# Otherwise:
#
#   tun0 -> tun1 -> tun2 -> tun3
#   wg0  -> wg1  -> wg2  -> wg3
#
# are preferred for CTF/VPN usage.
#
# If no VPN interface exists, the default-route interface
# is selected.
#
# ============================================================

detect_ip() {

    # --------------------------------------------------------
    # Always detect all interfaces first
    # --------------------------------------------------------

    detect_all_interfaces

    # --------------------------------------------------------
    # User explicitly selected interface
    # --------------------------------------------------------

    if [[ -n "$INTERFACE" ]]; then

        if ! ip link show "$INTERFACE" >/dev/null 2>&1; then

            log_error "Interface not found: $INTERFACE"

            echo
            echo "Available interfaces:"

            local entry
            local iface
            local ip_addr

            for entry in "${INTERFACE_LIST[@]}"; do

                iface="${entry%%|*}"
                ip_addr="${entry#*|}"

                echo "  $iface : $ip_addr"

            done

            exit 1
        fi

        MY_IP="$(
            ip -4 addr show "$INTERFACE" 2>/dev/null |
            awk '
                /inet / && $2 !~ /^127\./ {
                    print $2
                }
            ' |
            cut -d/ -f1 |
            head -n 1
        )"

        if [[ -z "$MY_IP" ]]; then

            log_error "No usable IPv4 address found on interface: $INTERFACE"

            exit 1

        fi

        return
    fi

    # --------------------------------------------------------
    # Automatically prefer CTF/VPN interfaces
    # --------------------------------------------------------

    local iface
    local ip_addr

    for iface in \
        tun0 tun1 tun2 tun3 tun4 tun5 \
        wg0 wg1 wg2 wg3 wg4 wg5
    do

        ip_addr="$(
            ip -4 addr show "$iface" 2>/dev/null |
            awk '
                /inet / && $2 !~ /^127\./ {
                    print $2
                }
            ' |
            cut -d/ -f1 |
            head -n 1
        )"

        if [[ -n "$ip_addr" ]]; then

            INTERFACE="$iface"
            MY_IP="$ip_addr"

            return

        fi

    done

    # --------------------------------------------------------
    # No VPN found.
    # Use default route interface.
    # --------------------------------------------------------

    local route_iface=""

    route_iface="$(
        ip route get 1.1.1.1 2>/dev/null |
        awk '
            {
                for (i = 1; i <= NF; i++) {

                    if ($i == "dev") {
                        print $(i+1)
                        exit
                    }

                }
            }
        '
    )"

    if [[ -n "$route_iface" && "$route_iface" != "lo" ]]; then

        ip_addr="$(
            ip -4 addr show "$route_iface" 2>/dev/null |
            awk '
                /inet / && $2 !~ /^127\./ {
                    print $2
                }
            ' |
            cut -d/ -f1 |
            head -n 1
        )"

        if [[ -n "$ip_addr" ]]; then

            INTERFACE="$route_iface"
            MY_IP="$ip_addr"

            return

        fi

    fi

    # --------------------------------------------------------
    # Final fallback
    # First non-loopback interface
    # --------------------------------------------------------

    if (( ${#INTERFACE_LIST[@]} > 0 )); then

        INTERFACE="${INTERFACE_LIST[0]%%|*}"
        MY_IP="${INTERFACE_LIST[0]#*|}"

        return

    fi

    # --------------------------------------------------------
    # Nothing available
    # --------------------------------------------------------

    INTERFACE=""
    MY_IP=""

    log_warning "No usable non-loopback IPv4 interface found."
}

# ============================================================
# Show ALL Interfaces
# ============================================================

show_all_interfaces() {

    echo -e "${C}Network Interfaces${NC}"
    echo

    if (( ${#INTERFACE_LIST[@]} == 0 )); then

        echo -e "  ${Y}No non-loopback IPv4 interfaces detected.${NC}"
        echo

        return

    fi

    local entry
    local iface
    local ip_addr

    for entry in "${INTERFACE_LIST[@]}"; do

        iface="${entry%%|*}"
        ip_addr="${entry#*|}"

        if [[ "$iface" == "$INTERFACE" ]]; then

            echo -e "  ${G}${iface}${NC} : ${G}${ip_addr}${NC} ${Y}< selected >${NC}"

        else

            echo -e "  ${W}${iface}${NC} : ${ip_addr}"

        fi

    done

    echo
}

# ============================================================
# Directory Validation
# ============================================================

validate_directory() {

    if [[ ! -d "$WORKDIR" ]]; then

        log_error "Directory does not exist: $WORKDIR"

        exit 1

    fi

    if [[ ! -r "$WORKDIR" ]]; then

        log_error "Directory is not readable: $WORKDIR"

        exit 1

    fi

    WORKDIR="$(cd "$WORKDIR" && pwd)"
}

# ============================================================
# Port Validation
# ============================================================

validate_port() {

    if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then

        log_error "Invalid port: $PORT"

        exit 1

    fi

    if (( PORT < 1 || PORT > 65535 )); then

        log_error "Port must be between 1 and 65535."

        exit 1

    fi
}

# ============================================================
# Port Availability
# ============================================================

check_port_available() {

    local port="$1"

    if command_exists ss; then

        if ss -lnt 2>/dev/null |
            awk '{print $4}' |
            grep -Eq ":${port}$"
        then

            log_error "TCP port $port is already in use."

            exit 1

        fi

    fi
}

